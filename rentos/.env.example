# Supabase project settings (Project Settings -> API in the Supabase dashboard).
# The anon key is safe to ship to the browser; it only grants what RLS allows.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Never prefix with NEXT_PUBLIC_, never import from client code.
# Bypasses RLS entirely -- used only for trusted server-side jobs (webhooks, admin tasks).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Added in Phase 3 (public booking + payments). Leave blank until then.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
