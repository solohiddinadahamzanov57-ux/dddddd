# Supabase project settings (Project Settings -> API in the Supabase dashboard).
# The anon key is safe to ship to the browser; it only grants what RLS allows.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Never prefix with NEXT_PUBLIC_, never import from client code.
# Bypasses RLS entirely -- used only for trusted server-side jobs (webhooks, admin tasks).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe test-mode keys (dashboard.stripe.com -> Developers -> API keys).
# The public booking flow and its webhook (src/app/api/stripe/webhook) work
# without these -- reservations just stay "pending payment" until they're set.
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:3000/api/stripe/webhook` locally,
# or the deployed webhook endpoint's signing secret in the Stripe dashboard.
STRIPE_WEBHOOK_SECRET=
